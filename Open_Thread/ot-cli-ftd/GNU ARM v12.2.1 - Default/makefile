# Tool invocations
ot-cli-ftd.axf: $(OBJS) $(USER_OBJS) makefile objects.mk $(OPTIONAL_TOOL_DEPS)
	@echo 'Building target: $@'
	@echo 'Invoking: GNU ARM C++ Linker'
	arm-none-eabi-g++ '@ot-cli-ftd.axf.rsp' -o ot-cli-ftd.axf 
	@echo 'Finished building target: $@'
	@echo ' '

	@echo 'Building out file: ot-cli-ftd.out'
	arm-none-eabi-objcopy "ot-cli-ftd.axf" "ot-cli-ftd.out"
	@echo ' '

	@echo 'Building hex file: ot-cli-ftd.hex'
	arm-none-eabi-objcopy -O ihex "ot-cli-ftd.axf" "ot-cli-ftd.hex"
	@echo ' '

	@echo 'Building bin file: ot-cli-ftd.bin'
	arm-none-eabi-objcopy -O binary "ot-cli-ftd.axf" "ot-cli-ftd.bin"
	@echo ' '

	@echo 'Building s37 file: ot-cli-ftd.s37'
	arm-none-eabi-objcopy -O srec "ot-cli-ftd.axf" "ot-cli-ftd.s37"
	@echo ' '

	@echo 'Running size tool'
	arm-none-eabi-size "ot-cli-ftd.axf" -A
	@echo ' '

