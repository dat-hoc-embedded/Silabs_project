name\">}<\/div><div class=\"classdescription\"><p style=\"color:inherit\">Oversampling selection, used for asynchronous operation. <\/p><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">enum<\/div><div class=\"column\"><div class=\"attributename\"><a href=\"#sl-hal-usart-parity-t\">sl_hal_usart_parity_t<\/a> {<\/div><div class=\"enum\">SL_HAL_USART_NO_PARITY = _USART_FRAME_PARITY_NONE<\/div><div class=\"enum\">SL_HAL_USART_EVEN_PARITY = _USART_FRAME_PARITY_EVEN<\/div><div class=\"enum\">SL_HAL_USART_ODD_PARITY = _USART_FRAME_PARITY_ODD<\/div><div class=\"attributename\">}<\/div><div class=\"classdescription\"><p style=\"color:inherit\">Parity selection, mainly used for asynchronous operation. <\/p><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">enum<\/div><div class=\"column\"><div class=\"attributename\"><a href=\"#sl-hal-usart-stop-bits-t\">sl_hal_usart_stop_bits_t<\/a> {<\/div><div class=\"enum\">SL_HAL_USART_STOP_BITS_0P5 = _USART_FRAME_STOPBITS_HALF<\/div><div class=\"enum\">SL_HAL_USART_STOP_BITS_1 = _USART_FRAME_STOPBITS_ONE<\/div><div class=\"enum\">SL_HAL_USART_STOP_BITS_1P5 = _USART_FRAME_STOPBITS_ONEANDAHALF<\/div><div class=\"enum\">SL_HAL_USART_STOP_BITS_2 = _USART_FRAME_STOPBITS_TWO<\/div><div class=\"attributename\">}<\/div><div class=\"classdescription\"><p style=\"color:inherit\">Stop bits selection, used for asynchronous operation. <\/p><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">enum<\/div><div class=\"column\"><div class=\"attributename\"><a href=\"#sl-hal-usart-majority-vote-t\">sl_hal_usart_majority_vote_t<\/a> {<\/div><div class=\"enum\">SL_HAL_USART_MAJORITY_VOTE_ENABLE = 0<\/div><div class=\"enum\">SL_HAL_USART_MAJORITY_VOTE_DISABLE = 1<\/div><div class=\"attributename\">}<\/div><div class=\"classdescription\"><p style=\"color:inherit\">Majority vote enable. <\/p><\/div><\/div><\/div><\