ific pin count. <\/p><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_B_PIN_COUNT (GPIO_PB_COUNT)<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_C_PIN_COUNT (GPIO_PC_COUNT)<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_D_PIN_COUNT (GPIO_PD_COUNT)<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_E_PIN_COUNT 0<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_F_PIN_COUNT 0<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_G_PIN_COUNT 0<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_H_PIN_COUNT 0<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_I_PIN_COUNT 0<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_J_PIN_COUNT 0<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_K_PIN_COUNT 0<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_SIZE (port)<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_MASK (port)<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_IS_VALID (port)<\/div><div class=\"classdescription\"><p style=\"color:inherit\">Validation of port. <\/p><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_PORT_PIN_IS_VALID (port, pin)<\/div><div class=\"classdescription\"><p style=\"color:inherit\">Validation of port and pin. <\/p><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_INTERRUPT_MAX 15<\/div><div class=\"classdescription\"><p style=\"color:inherit\">Max interrupt lines for external and EM4 interrupts. <\/p><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_EM4WUEN_SHIFT _GPIO_EM4WUEN_EM4WUEN_SHIFT<\/div><div class=\"classdescription\"><p style=\"color:inherit\">Shift value for EM4WUEN. <\/p><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_INT_IF_EVEN_MASK ((_GPIO_IF_MASK) &amp; 0x55555555UL)<\/div><div class=\"classdescription\"><p style=\"color:inherit\">Masks for even and odd interrupt bits. <\/p><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_INT_IF_ODD_MASK ((_GPIO_IF_MASK) &amp; 0xAAAAAAAAUL)<\/div><div class=\"classdescription\"><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_MODE_IS_VALID (mode)<\/div><div class=\"classdescription\"><p style=\"color:inherit\">Validation of mode. <\/p><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_INTNO_PIN_VALID (int_no, pin)<\/div><div class=\"classdescription\"><p style=\"color:inherit\">Validation of interrupt number and pin. <\/p><\/div><\/div><\/div><\/div><div><div class=\"columns\"><div class=\"attributename has-text-right\">#define<\/div><div class=\"column\"><div class=\"attributename\">SL_HAL_GPIO_SLEWRATE_INVALID (0xFF)<\/div><div class=\"classdescription\"><p style=\"color:inherit\">Invalid Slewrate. <\/p><\/div><\/div><\/div><\/div><\/div><div class=\"def-class-section\"><h2>Function Documentation<span id=\"func-definition\" class=\"self-anchor\"><a class=\"perm\" href=\"#func-definition\">#<\/a><\/span><\/h2><div><h3>sl_hal_gpio_set_pin_mode<span id=\"sl-hal-gpio-set-pin-mode\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-set-pin-mode\">#<\/a><\/span><\/h3><blockquote>void sl_hal_gpio_set_pin_mode (const sl_gpio_t * gpio, sl_gpio_mode_t mode, bool output_value)<\/blockquote><p style=\"color:inherit\">Set the mode for a GPIO pin. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>const sl_gpio_t *<\/td><td>[in]<\/td><td class=\"paramname\">gpio<\/td><td><p style=\"color:inherit\">Pointer to GPIO structure with port and pin <\/p><\/td><\/tr><tr><td>sl_gpio_mode_t<\/td><td>[in]<\/td><td class=\"paramname\">mode<\/td><td><p style=\"color:inherit\">The desired pin mode. <\/p><\/td><\/tr><tr><td>bool<\/td><td>[in]<\/td><td class=\"paramname\">output_value<\/td><td><p style=\"color:inherit\">A value to set for the pin in the DOUT register. The DOUT setting is important for some input mode configurations to determine the pull-up/down direction. <\/p><\/td><\/tr><\/tbody><\/table><\/div><br><\/div><div><h3>sl_hal_gpio_get_pin_mode<span id=\"sl-hal-gpio-get-pin-mode\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-get-pin-mode\">#<\/a><\/span><\/h3><blockquote>sl_gpio_mode_t sl_hal_gpio_get_pin_mode (const sl_gpio_t * gpio)<\/blockquote><p style=\"color:inherit\">Get the mode for a GPIO pin. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>const sl_gpio_t *<\/td><td>[in]<\/td><td class=\"paramname\">gpio<\/td><td><p style=\"color:inherit\">Pointer to GPIO structure with port and pin<\/p><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Returns<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">Return the pin mode. <\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_configure_external_interrupt<span id=\"sl-hal-gpio-configure-external-interrupt\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-configure-external-interrupt\">#<\/a><\/span><\/h3><blockquote>int32_t sl_hal_gpio_configure_external_interrupt (const sl_gpio_t * gpio, int32_t int_no, sl_gpio_interrupt_flag_t flags)<\/blockquote><p style=\"color:inherit\">Configure the GPIO external pin interrupt by connecting external interrupt id with gpio pin. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>const sl_gpio_t *<\/td><td>[in]<\/td><td class=\"paramname\">gpio<\/td><td><p style=\"color:inherit\">Pointer to GPIO structure with port and pin <\/p><\/td><\/tr><tr><td>int32_t<\/td><td>[in]<\/td><td class=\"paramname\">int_no<\/td><td><p style=\"color:inherit\">The interrupt number to trigger. <\/p><\/td><\/tr><tr><td>sl_gpio_interrupt_flag_t<\/td><td>[in]<\/td><td class=\"paramname\">flags<\/td><td><p style=\"color:inherit\">Interrupt configuration flags. sl_hal_gpio_interrupt_flag_t for more information.<\/p><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Note<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">This function configure the pin interrupt with pin ,port and external interrupt id as input. If external interrupt id is provided as input it will be considered as the input or else available interrupt number will be generated by looping through the interrupt group and will be used. User can provide SL_HAL_GPIO_INTERRUPT_UNAVAILABLE if user don't want to provide interrupt id. <\/p><\/li><li><p style=\"color:inherit\">the pin number can be selected freely within a group. Interrupt numbers are divided into 4 groups (int_no / 4) and valid pin number within the interrupt groups are: 0: pins 0-3 (interrupt number 0-3) 1: pins 4-7 (interrupt number 4-7) 2: pins 8-11 (interrupt number 8-11) 3: pins 12-15 (interrupt number 12-15) <\/p><\/li><li><p style=\"color:inherit\">It is recommended to disable interrupts before configuring the GPIO pin interrupt. See <a href=\"http://docs.silabs.com/gecko-platform/5.2.2/platform-peripheral-efr32xg24/gpio#sl-hal-gpio-disable-interrupts\" target=\"_blank\" rel=\"\">sl_hal_gpio_disable_interrupts()<\/a> for more information. The GPIO interrupt handler must be in place before enabling the interrupt. Notice that any pending interrupt for the selected interrupt is cleared by this function. Notice that only interrupt will be configured by this function. It is not enabled. It is recommended to enable interrupts after configuring the GPIO pin interrupt if needed. See <a href=\"http://docs.silabs.com/gecko-platform/5.2.2/platform-peripheral-efr32xg24/gpio#sl-hal-gpio-enable-interrupts\" target=\"_blank\" rel=\"\">sl_hal_gpio_enable_interrupts()<\/a> for more information.<\/p><\/li><\/ul><p style=\"color:inherit\"><strong>Returns<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">Return the available interrupt number <\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_enable_pin_em4_wakeup<span id=\"sl-hal-gpio-enable-pin-em4-wakeup\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-enable-pin-em4-wakeup\">#<\/a><\/span><\/h3><blockquote>void sl_hal_gpio_enable_pin_em4_wakeup (uint32_t pinmask, uint32_t polaritymask)<\/blockquote><p style=\"color:inherit\">Enable GPIO pin wake-up from EM4. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>uint32_t<\/td><td>[in]<\/td><td class=\"paramname\">pinmask<\/td><td><p style=\"color:inherit\">A bitmask containing the bitwise logic OR of which GPIO pin(s) to enable. <\/p><\/td><\/tr><tr><td>uint32_t<\/td><td>[in]<\/td><td class=\"paramname\">polaritymask<\/td><td><p style=\"color:inherit\">A bitmask containing the bitwise logic OR of GPIO pin(s) wake-up polarity. <\/p><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\">When the function exits, EM4 mode can be safely entered.<\/p><p style=\"color:inherit\"><strong>Note<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">It is assumed that the GPIO pin modes are set correctly. Valid modes are SL_GPIO_MODE_INPUT and SL_GPIO_MODE_INPUT_PULL.<\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_configure_wakeup_em4_external_interrupt<span id=\"sl-hal-gpio-configure-wakeup-em4-external-interrupt\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-configure-wakeup-em4-external-interrupt\">#<\/a><\/span><\/h3><blockquote>int32_t sl_hal_gpio_configure_wakeup_em4_external_interrupt (const sl_gpio_t * gpio, int32_t int_no, bool polarity)<\/blockquote><p style=\"color:inherit\">Configure EM4WU pins as external level-sensitive interrupts. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>const sl_gpio_t *<\/td><td>[in]<\/td><td class=\"paramname\">gpio<\/td><td><p style=\"color:inherit\">Pointer to GPIO structure with port and pin <\/p><\/td><\/tr><tr><td>int32_t<\/td><td>[in]<\/td><td class=\"paramname\">int_no<\/td><td><p style=\"color:inherit\">The EM4WU interrupt number to trigger. <\/p><\/td><\/tr><tr><td>bool<\/td><td>[in]<\/td><td class=\"paramname\">polarity<\/td><td><p style=\"color:inherit\">true = Active high level-sensitive interrupt. false = Active low level-sensitive interrupt.<\/p><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Note<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">It is recommended to disable interrupts before configuring the GPIO pin interrupt. See <a href=\"http://docs.silabs.com/gecko-platform/5.2.2/platform-peripheral-efr32xg24/gpio#sl-hal-gpio-disable-interrupts\" target=\"_blank\" rel=\"\">sl_hal_gpio_disable_interrupts()<\/a> for more information. The provided port, pin and int_no inputs should be valid EM4 related parameters because there are dedicated port, pin and EM4 Wakeup interrupt combination for configuring the port, pin for EM4 functionality. User can provide SL_HAL_GPIO_INTERRUPT_UNAVAILABLE if user don't want to provide interrupt id. The GPIO interrupt handler must be in place before enabling the interrupt. Notice that any pending interrupt for the selected interrupt is cleared by this function. Notice that any only EM4WU interrupt is configured by this function. It is not enabled. It is recommended to enable interrupts after configuring the GPIO pin interrupt if needed. See <a href=\"http://docs.silabs.com/gecko-platform/5.2.2/platform-peripheral-efr32xg24/gpio#sl-hal-gpio-enable-interrupts\" target=\"_blank\" rel=\"\">sl_hal_gpio_enable_interrupts()<\/a> for more information.<\/p><\/li><\/ul><p style=\"color:inherit\"><strong>Returns<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">Return the available EM4WU interrupt number <\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_lock<span id=\"sl-hal-gpio-lock\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-lock\">#<\/a><\/span><\/h3><blockquote>void sl_hal_gpio_lock (void )<\/blockquote><p style=\"color:inherit\">Lock the GPIO configuration. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>void<\/td><td>N/A<\/td><td class=\"paramname\"><\/td><td><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Note<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">Configuration lock affects the GPIO_Px_MODEL, GPIO_Px_MODEH, GPIO_Px_CTRL, GPIO_Px_PINLOCKN, GPIO_EXTIPSELL, GPIO_EXTIPSELH, GPIO_EXTIPINSELL, GPIO_EXTIPINSELH, GPIO_INSENSE, GPIO_ROUTE, GPIO_ROUTEPEN, and GPIO_ROUTELOC0 registers when they are present on a specific device. <\/p><\/li><li><p style=\"color:inherit\">Unwanted or accidental changes to GPIO configuration can be avoided by using the configuration lock register. Any value other than 0xA534 written to GPIO_LOCK enables the configuration lock. Pins are unlocked by a reset or by writing 0xA534 to the GPIO_LOCK register. <\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_unlock<span id=\"sl-hal-gpio-unlock\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-unlock\">#<\/a><\/span><\/h3><blockquote>void sl_hal_gpio_unlock (void )<\/blockquote><p style=\"color:inherit\">Unlock the GPIO configuration. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>void<\/td><td>N/A<\/td><td class=\"paramname\"><\/td><td><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Note<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">Configuration lock affects the GPIO_Px_MODEL, GPIO_Px_MODEH, GPIO_Px_CTRL, GPIO_Px_PINLOCKN, GPIO_EXTIPSELL, GPIO_EXTIPSELH, GPIO_EXTIPINSELL, GPIO_EXTIPINSELH, GPIO_INSENSE, GPIO_ROUTE, GPIO_ROUTEPEN, and GPIO_ROUTELOC0 registers when they are present on a specific device. <\/p><\/li><li><p style=\"color:inherit\">Unwanted or accidental changes to GPIO configuration can be avoided by using the configuration lock register. Any value other than 0xA534 written to GPIO_LOCK enables the configuration lock. Pins are unlocked by a reset or by writing 0xA534 to the GPIO_LOCK register. <\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_get_lock_status<span id=\"sl-hal-gpio-get-lock-status\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-get-lock-status\">#<\/a><\/span><\/h3><blockquote>uint32_t sl_hal_gpio_get_lock_status (void )<\/blockquote><p style=\"color:inherit\">Gets the GPIO configuration state. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>void<\/td><td>N/A<\/td><td class=\"paramname\"><\/td><td><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Returns<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">Return the GPIO lock state. <\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_set_pin<span id=\"sl-hal-gpio-set-pin\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-set-pin\">#<\/a><\/span><\/h3><blockquote>void sl_hal_gpio_set_pin (const sl_gpio_t * gpio)<\/blockquote><p style=\"color:inherit\">Set a single pin in GPIO data out register to 1. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>const sl_gpio_t *<\/td><td>[in]<\/td><td class=\"paramname\">gpio<\/td><td><p style=\"color:inherit\">Pointer to GPIO structure with port and pin <\/p><\/td><\/tr><\/tbody><\/table><\/div><br><\/div><div><h3>sl_hal_gpio_set_port<span id=\"sl-hal-gpio-set-port\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-set-port\">#<\/a><\/span><\/h3><blockquote>void sl_hal_gpio_set_port (sl_gpio_port_t port, uint32_t pins)<\/blockquote><p style=\"color:inherit\">Set bits GPIO data out register to 1. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>sl_gpio_port_t<\/td><td>[in]<\/td><td class=\"paramname\">port<\/td><td><p style=\"color:inherit\">The GPIO port to access. <\/p><\/td><\/tr><tr><td>uint32_t<\/td><td>[in]<\/td><td class=\"paramname\">pins<\/td><td><p style=\"color:inherit\">Bit mask for bits to set to 1 in DOUT register. <\/p><\/td><\/tr><\/tbody><\/table><\/d