nt32_t sl_hal_gpio_get_external_interrupt_number (uint8_t pin, uint32_t enabled_interrupts_mask)<\/blockquote><p style=\"color:inherit\">The available external interrupt number getter. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>uint8_t<\/td><td>[in]<\/td><td class=\"paramname\">pin<\/td><td><p style=\"color:inherit\">The GPIO pin to access. <\/p><\/td><\/tr><tr><td>uint32_t<\/td><td>[in]<\/td><td class=\"paramname\">enabled_interrupts_mask<\/td><td><p style=\"color:inherit\">Contains enabled GPIO interrupts mask.<\/p><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Returns<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">The available interrupt number based on interrupt and pin grouping. <\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_get_em4_interrupt_number<span id=\"sl-hal-gpio-get-em4-interrupt-number\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-get-em4-interrupt-number\">#<\/a><\/span><\/h3><blockquote>int32_t sl_hal_gpio_get_em4_interrupt_number (const sl_gpio_t * gpio)<\/blockquote><p style=\"color:inherit\">The available em4 wakeup interrupt number getter. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>const sl_gpio_t *<\/td><td>[in]<\/td><td class=\"paramname\">gpio<\/td><td><p style=\"color:inherit\">Pointer to GPIO structure with port and pin.<\/p><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Returns<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">The available em4 wakeup interrupt number based on associated port and pin. <\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_disable_pin_em4_wakeup<span id=\"sl-hal-gpio-disable-pin-em4-wakeup\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-disable-pin-em4-wakeup\">#<\/a><\/span><\/h3><blockquote>void sl_hal_gpio_disable_pin_em4_wakeup (uint32_t pinmask)<\/blockquote><p style=\"color:inherit\">Disable GPIO pin wake-up from EM4. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>uint32_t<\/td><td>[in]<\/td><td class=\"paramname\">pinmask<\/td><td><p style=\"color:inherit\">Bit mask containing the bitwise logic OR of which GPIO pin(s) to disable. <\/p><\/td><\/tr><\/tbody><\/table><\/div><br><\/div><div><h3>sl_hal_gpio_set_pin_em4_retention<span id=\"sl-hal-gpio-set-pin-em4-retention\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-set-pin-em4-retention\">#<\/a><\/span><\/h3><blockquote>void sl_hal_gpio_set_pin_em4_retention (bool enable)<\/blockquote><p style=\"color:inherit\">Enable GPIO pin retention of output enable, output value, pull enable, and pull direction in EM4. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>bool<\/td><td>[in]<\/td><td class=\"paramname\">enable<\/td><td><p style=\"color:inherit\">true - enable EM4 pin retention. false - disable EM4 pin retention. <\/p><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Note<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">The behavior of this function depends on the configured GPIO retention mode. If the GPIO retention mode is configured to be \"SWUNLATCH\" then this function will not change anything. If the retention mode is anything else then this function will set the GPIO retention mode to \"EM4EXIT\" when the enable argument is true, and \"Disabled\" when false.<\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_get_pin_em4_wakeup_cause<span id=\"sl-hal-gpio-get-pin-em4-wakeup-cause\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-get-pin-em4-wakeup-cause\">#<\/a><\/span><\/h3><blockquote>uint32_t sl_hal_gpio_get_pin_em4_wakeup_cause (void )<\/blockquote><p style=\"color:inherit\">Check which GPIO pin(s) that caused a wake-up from EM4. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>void<\/td><td>N/A<\/td><td class=\"paramname\"><\/td><td><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Returns<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">Bit mask containing the bitwise logic OR of which GPIO pin(s) caused the wake-up. <\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_enable_debug_swo<span id=\"sl-hal-gpio-enable-debug-swo\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-enable-debug-swo\">#<\/a><\/span><\/h3><blockquote>void sl_hal_gpio_enable_debug_swo (bool enable)<\/blockquote><p style=\"color:inherit\">Enable/Disable serial wire output pin. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>bool<\/td><td>[in]<\/td><td class=\"paramname\">enable<\/td><td><p style=\"color:inherit\">false - disable serial wire viewer pin (default after reset). true - enable serial wire viewer pin. <\/p><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Note<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">Enabling this pin is not sufficient to fully enable serial wire output, which is also dependent on issues outside the GPIO module. <\/p><\/li><li><p style=\"color:inherit\">If debug port is locked, SWO pin is not disabled automatically. To avoid information leakage through SWO, disable SWO pin after locking debug port.<\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_enable_debug_swd_clk<span id=\"sl-hal-gpio-enable-debug-swd-clk\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-enable-debug-swd-clk\">#<\/a><\/span><\/h3><blockquote>void sl_hal_gpio_enable_debug_swd_clk (bool enable)<\/blockquote><p style=\"color:inherit\">Enable/disable serial wire clock pin. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>bool<\/td><td>[in]<\/td><td class=\"paramname\">enable<\/td><td><p style=\"color:inherit\">false - disable serial wire clock. true - enable serial wire clock (default after reset). <\/p><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Note<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">Disabling SWDClk will disable the debug interface, which may result in a lockout if done early in startup (before debugger is able to halt core).<\/p><\/li><\/ul><br><\/div><div><h3>sl_hal_gpio_enable_debug_swd_io<span id=\"sl-hal-gpio-enable-debug-swd-io\" class=\"self-anchor\"><a class=\"perm\" href=\"#sl-hal-gpio-enable-debug-swd-io\">#<\/a><\/span><\/h3><blockquote>void sl_hal_gpio_enable_debug_swd_io (bool enable)<\/blockquote><p style=\"color:inherit\">Enable/disable serial wire data I/O pin. <\/p><div class=\"parameters-section\"><strong class=\"parameters\">Parameters<\/strong><table><thead><tr><th>Type<\/th><th>Direction<\/th><th>Argument Name<\/th><th>Description<\/th><\/tr><\/thead><tbody><tr><td>bool<\/td><td>[in]<\/td><td class=\"paramname\">enable<\/td><td><p style=\"color:inherit\">false - disable serial wire data pin. true - enable serial wire data pin (default after reset). <\/p><\/td><\/tr><\/tbody><\/table><\/div><p style=\"color:inherit\"><strong>Note<\/strong><\/p><ul style=\"list-style:\"><li><p style=\"color:inherit\">Disabling SWDClk will disable the debug interface, which may result in a lockout if done early in startup (before debugger is able to halt core).<\/p><\/li><\/ul><br><\/div><\/div><div class=\"def-class-section\"><h2>&nbsp;<\/h2><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><div><\/div><\/div><\/div><\/article><footer class=\"footer-commons-msg\"><\/footer><div class=\"light_theme hidden-lg\" ub-in-page=\"634f96f53042a864e44b82f8\"><\/div><div class=\"dark_theme hidden-lg\" ub-in-page=\"699fe6e9dac31e032209597c\"><\/div><div id=\"page-nav-buttons\" class=\"page-nav-buttons\"><\/div>","url":"http://docs.silabs.com/gecko-platform/5.2.2/platform-peripheral-efr32xg24/gpio","status":"success"}
